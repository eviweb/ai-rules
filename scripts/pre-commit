#!/usr/bin/env bash
set -euo pipefail

# pre-commit — Regenerate flat rule files for agents with supports_imports=false
#              when rules/ or the canonical import source changes.
#
# Install:
#   ln -sf ../../scripts/pre-commit .git/hooks/pre-commit

REPO_ROOT="$(git rev-parse --show-toplevel)"
VENV="${REPO_ROOT}/.venv"

# Trigger when rules/ files or the Claude import source are staged
if ! git diff --cached --name-only | grep -qE '^rules/|^agents/claude/CLAUDE\.md'; then
  exit 0
fi

if [[ ! -x "${VENV}/bin/python3" ]]; then
  echo "pre-commit: .venv not found — skipping generate (run: uv sync --extra dev)" >&2
  exit 0
fi

echo "pre-commit: source changed — regenerating flat files for applicable agents..."
cd "${REPO_ROOT}"
"${VENV}/bin/python3" -m ai_rules.cli generate

# Stage regenerated flat files so they are included in the commit
git diff --name-only | { grep '^agents/' || true; } | xargs --no-run-if-empty git add

echo "pre-commit: done."
